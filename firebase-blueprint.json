{
  "entities": {
    "Project": {
      "title": "Project",
      "description": "Video caption project authored by the user",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier of the project"
        },
        "userId": {
          "type": "string",
          "description": "Owner Google User ID"
        },
        "title": {
          "type": "string",
          "description": "Project title"
        },
        "aspectRatio": {
          "type": "string",
          "description": "Video aspect ratio (9:16, 1:1, 16:9)"
        },
        "durationMs": {
          "type": "integer",
          "description": "Video duration in milliseconds"
        },
        "captionsJson": {
          "type": "string",
          "description": "Serialized JSON array of CaptionItems"
        },
        "styleJson": {
          "type": "string",
          "description": "Serialized JSON of CaptionStyle"
        },
        "videoBackgroundPreset": {
          "type": "string",
          "description": "Background preset identifier"
        },
        "language": {
          "type": "string",
          "description": "Primary caption language"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Last update timestamp"
        }
      },
      "required": ["id", "userId", "title", "aspectRatio", "durationMs", "captionsJson", "styleJson"]
    }
  },
  "firestore": {
    "/users/{userId}/projects/{projectId}": {
      "schema": "Project",
      "description": "User specific video caption projects"
    }
  }
}
